# 이 파일을 .env.local로 복사한 뒤 값을 채운다. .env.local은 커밋하지 않는다.
# Supabase 대시보드 → Project Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# anon(legacy) 키 또는 publishable 키(sb_publishable_...) 어느 쪽이든 된다
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase에서 Google 로그인 공급자를 설정한 뒤 true로 바꾼다
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false
